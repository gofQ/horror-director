{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": true,
        "allowTernary": true
      }
    ],
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/globals": "off",
    "react/hooks": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "test-results/**",
    "playwright-report/**",
    "node_modules/**"
  ]
}
